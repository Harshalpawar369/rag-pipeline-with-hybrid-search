# Copy the values you need into your shell or your process manager. The app reads environment
# variables directly and does not load a .env file.

# Databases
PG_DSN=postgresql://legalrag_app:legalrag_app@localhost:5432/legalrag
MIGRATE_DSN=postgresql://postgres:postgres@localhost:5432/legalrag
REDIS_URL=redis://localhost:6379/0

# OpenRouter (https://openrouter.ai). Leave the key empty to run offline (development only).
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-4b
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Legal RAG
# Vector size. Fixed at the first migration: changing it requires a fresh database and re-embedding.
EMBED_DIM=1024

# Authentication (FastAPI OAuth2 password flow with opaque session tokens)
SESSION_TTL_HOURS=12
ALLOW_REGISTRATION=true          # set to false once accounts are provisioned
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
SEED_PASSWORD=demo-password-123  # used only by scripts/seed.py

# Origins allowed to open the WebSocket
ALLOWED_ORIGINS=http://localhost:8000

# Limits
MAX_UPLOAD_MB=5
MAX_PAGES=200
BLOB_DIR=./data/blobs
STM_TURNS=6
STM_TTL_SECONDS=3600
WS_ASKS_PER_MINUTE=20
